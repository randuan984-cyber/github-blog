---
// ArticleLayout.astro — For blog posts and notes
// SPEC: SPEC-BLOG-001, SPEC-NOTES-001

import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  categories?: string[];
  readingTime?: number;
  backLink?: string;
  backLabel?: string;
}

const {
  title,
  description,
  date,
  tags = [],
  categories = [],
  readingTime,
  backLink = '../',
  backLabel = 'Back',
} = Astro.props;

const formattedDate = date
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(date)
  : null;

const base = import.meta.env.BASE_URL;
---

<BaseLayout {title} {description} article={true}>
  <article class="article-layout container">
    <header class="article-header">
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <a href={backLink} class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          {backLabel}
        </a>
      </nav>

      <div class="article-meta">
        {categories.length > 0 && (
          <div class="article-categories">
            {categories.map((cat) => (
              <span class="tag">{cat}</span>
            ))}
          </div>
        )}

        <h1 class="article-title">{title}</h1>

        {description && (
          <p class="article-description">{description}</p>
        )}

        <div class="article-info">
          {formattedDate && (
            <time datetime={date?.toISOString()} class="article-date">
              {formattedDate}
            </time>
          )}
          {readingTime && (
            <span class="article-reading-time">{readingTime} min read</span>
          )}
        </div>

        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <a href={`${base}blog/?tag=${tag}`} class="tag">#{tag}</a>
            ))}
          </div>
        )}
      </div>

      <hr class="article-divider" />
    </header>

    <div class="prose article-body">
      <slot />
    </div>

    <footer class="article-footer">
      <a href={backLink} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        {backLabel}
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-layout {
    padding-block: var(--space-12);
    max-width: var(--container-md);
  }

  .article-breadcrumb {
    margin-bottom: var(--space-8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .article-header {
    margin-bottom: var(--space-10);
  }

  .article-categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .article-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .article-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .article-info {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .article-date,
  .article-reading-time {
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .article-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-8) 0;
  }

  .article-body {
    margin-bottom: var(--space-16);
  }

  .article-footer {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: var(--text-3xl);
    }
  }
</style>
