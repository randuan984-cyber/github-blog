---
// projects/[slug].astro — Project Detail Page
// SPEC: SPEC-PROJECTS-001, TASK-006

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.(md|mdx)$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;

const statusBadge: Record<string, { label: string; class: string }> = {
  planning:     { label: 'Planning',     class: 'badge-planning' },
  learning:     { label: 'Learning',     class: 'badge-learning' },
  'in-progress':{ label: 'In Progress',  class: 'badge-in-progress' },
  completed:    { label: 'Completed',    class: 'badge-completed' },
  archived:     { label: 'Archived',     class: 'badge-archived' },
};

const badge = statusBadge[project.data.status] || statusBadge['planning'];
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  article={true}
>
  <article class="container project-article">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${base}projects/`} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        All Projects
      </a>
    </nav>

    <!-- Project Header -->
    <header class="project-header">
      <div class="project-badges">
        <span class={`badge ${badge.class}`}>{badge.label}</span>
        {project.data.source_type !== 'original' && (
          <span class="badge badge-oss">Open Source Study</span>
        )}
      </div>

      <h1 class="project-title">{project.data.title}</h1>
      <p class="project-description">{project.data.description}</p>

      <!-- Attribution block — MANDATORY for open-source projects -->
      {project.data.source_type !== 'original' && project.data.original_repository && (
        <div class="attribution-block" role="note" aria-label="Open source attribution">
          <div class="attribution-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Open Source Attribution
          </div>
          <p>
            This project is based on an existing open-source repository.
            My work involves studying, experimenting with, and potentially contributing to it —
            not original authorship.
          </p>
          <div class="attribution-links">
            <a href={project.data.original_repository} target="_blank" rel="noopener noreferrer" class="attr-link">
              Original Repository →
            </a>
            {project.data.my_repository && (
              <a href={project.data.my_repository} target="_blank" rel="noopener noreferrer" class="attr-link">
                My Fork / Study Repo →
              </a>
            )}
          </div>
          {project.data.my_contribution && (
            <p class="my-contribution">
              <strong>My contribution:</strong> {project.data.my_contribution}
            </p>
          )}
        </div>
      )}

      <!-- Metadata grid -->
      <div class="project-meta-grid">
        <div class="meta-item">
          <span class="meta-label">Date</span>
          <time datetime={project.data.date.toISOString()} class="meta-value">
            {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long' }).format(project.data.date)}
          </time>
        </div>

        {project.data.tech_stack.length > 0 && (
          <div class="meta-item">
            <span class="meta-label">Tech Stack</span>
            <div class="meta-tags">
              {project.data.tech_stack.map((tech) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
          </div>
        )}

        {project.data.tags.length > 0 && (
          <div class="meta-item">
            <span class="meta-label">Tags</span>
            <div class="meta-tags">
              {project.data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          </div>
        )}

        {project.data.my_repository && (
          <div class="meta-item">
            <span class="meta-label">My Repository</span>
            <a href={project.data.my_repository} target="_blank" rel="noopener noreferrer" class="meta-link">
              View on GitHub →
            </a>
          </div>
        )}

        {project.data.demo && (
          <div class="meta-item">
            <span class="meta-label">Demo</span>
            <a href={project.data.demo} target="_blank" rel="noopener noreferrer" class="meta-link">
              View Demo →
            </a>
          </div>
        )}
      </div>

      <hr class="header-divider" />
    </header>

    <!-- Case Study Body -->
    <div class="prose project-body">
      <Content />
    </div>

    <footer class="project-footer">
      <a href={`${base}projects/`} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        All Projects
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project-article {
    padding-block: var(--space-12);
    max-width: var(--container-md);
  }

  .breadcrumb {
    margin-bottom: var(--space-8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover { color: var(--color-accent); }

  .project-header {
    margin-bottom: var(--space-10);
  }

  .project-badges {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .badge-oss {
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-color: var(--color-accent-muted);
  }

  .project-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
    line-height: var(--leading-tight);
  }

  .project-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  /* Attribution block */
  .attribution-block {
    background-color: var(--color-accent-light);
    border: 1px solid var(--color-accent-muted);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-6);
  }

  .attribution-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .attribution-block p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    line-height: var(--leading-relaxed);
  }

  .attribution-links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .attr-link {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-accent);
    text-decoration: none;
  }

  .attr-link:hover { text-decoration: underline; }

  .my-contribution {
    font-size: var(--text-sm) !important;
    font-style: italic;
    margin-bottom: 0 !important;
  }

  /* Meta grid */
  .project-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-5);
    padding: var(--space-6);
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .meta-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .meta-value {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-family: 'JetBrains Mono', monospace;
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  .meta-link {
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
  }

  .meta-link:hover { text-decoration: underline; }

  .header-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-8) 0;
  }

  .project-body {
    margin-bottom: var(--space-16);
  }

  .project-footer {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .project-title { font-size: var(--text-3xl); }
    .project-meta-grid { grid-template-columns: 1fr; }
  }
</style>
