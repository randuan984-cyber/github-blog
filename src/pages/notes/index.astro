---
// notes/index.astro — Engineering Notes List
// SPEC: SPEC-NOTES-001, TASK-008

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const notes = allNotes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL;

const categories = [...new Set(notes.map((n) => n.data.category))].sort();

const categoryEmoji: Record<string, string> = {
  bug:           '🐛',
  debugging:     '🔍',
  architecture:  '🏗️',
  api:           '🔌',
  deployment:    '🚀',
  performance:   '⚡',
  refactoring:   '♻️',
  testing:       '🧪',
  decision:      '📝',
  general:       '📌',
};

const GITHUB_NEW_NOTE = 'https://github.com/randuan984-cyber/github-blog/new/main/src/content/notes';
---

<BaseLayout
  title="Engineering Notes"
  description="Real engineering problems — bugs, debugging sessions, architecture decisions, and lessons learned. Documented honestly."
>
  <div class="container page-container">
    <header class="page-header">
      <p class="section-label">Engineering Notebook</p>
      <h1 class="page-title">Notes</h1>
      <p class="page-subtitle">
        Real problems I encountered while building and studying.
        Format: Problem → Investigation → What Failed → Root Cause → Solution → Lesson.
      </p>
      <div class="header-actions">
        <a href={GITHUB_NEW_NOTE} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          记录新笔记
        </a>
      </div>
    </header>

    {categories.length > 0 && (
      <div class="category-filter" role="navigation" aria-label="Filter notes by category">
        <span class="filter-label">Category:</span>
        <div class="filter-pills">
          <a href={`${base}notes/`} class="filter-pill filter-pill--active">All</a>
          {categories.map((cat) => (
            <a href={`${base}notes/?category=${encodeURIComponent(cat)}`} class="filter-pill">
              {categoryEmoji[cat] || ''} {cat}
            </a>
          ))}
        </div>
      </div>
    )}

    {notes.length > 0 ? (
      <div class="notes-list">
        {notes.map((note) => (
          <a href={`${base}notes/${note.id.replace(/\.(md|mdx)$/, '')}/`} class="note-item card card-link">
            <div class="note-meta">
              <time datetime={note.data.date.toISOString()} class="note-date">
                {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(note.data.date)}
              </time>
              <span class="note-category">
                {categoryEmoji[note.data.category] || ''} {note.data.category}
              </span>
            </div>

            <h2 class="note-title">{note.data.title}</h2>
            <p class="note-problem">{note.data.problem}</p>

            {note.data.tags.length > 0 && (
              <div class="note-tags">
                {note.data.tags.slice(0, 4).map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon" aria-hidden="true">🔍</div>
        <h2>Notes Coming Soon</h2>
        <p>
          Engineering notes appear here as I encounter and solve real problems.
          I'm building the habit of documenting issues as they happen, not after the fact.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-container { padding-block: var(--space-16); }
  .page-header { margin-bottom: var(--space-10); }
  .page-title { font-size: var(--text-4xl); font-weight: var(--font-bold); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-4); }
  .page-subtitle { font-size: var(--text-lg); color: var(--color-text-muted); line-height: var(--leading-relaxed); }
  .header-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-5); }

  .category-filter { display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-8); flex-wrap: wrap; }
  .filter-label { font-size: var(--text-xs); font-weight: var(--font-semibold); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--color-text-faint); }
  .filter-pills { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .filter-pill { padding: var(--space-1-5) var(--space-4); font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid var(--color-border); border-radius: var(--radius-full); color: var(--color-text-muted); text-decoration: none; transition: all var(--transition-fast); }
  .filter-pill:hover, .filter-pill--active { background-color: var(--color-accent); border-color: var(--color-accent); color: #fff; }

  .notes-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .note-item { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); }

  .note-meta { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .note-date { font-size: var(--text-xs); color: var(--color-text-faint); font-family: 'JetBrains Mono', monospace; }
  .note-category { font-size: var(--text-xs); font-weight: var(--font-medium); color: var(--color-text-muted); background-color: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 0.15em 0.5em; text-transform: capitalize; }

  .note-title { font-size: var(--text-xl); font-weight: var(--font-semibold); color: var(--color-text); line-height: var(--leading-snug); }
  .note-problem { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--leading-relaxed); font-style: italic; }
  .note-tags { display: flex; flex-wrap: wrap; gap: var(--space-1-5); }

  .empty-state { text-align: center; padding: var(--space-20) var(--space-8); border: 1px dashed var(--color-border); border-radius: var(--radius-xl); background-color: var(--color-surface); }
  .empty-icon { font-size: 3rem; margin-bottom: var(--space-4); }
  .empty-state h2 { font-size: var(--text-2xl); margin-bottom: var(--space-4); }
  .empty-state p { color: var(--color-text-muted); max-width: 52ch; margin-inline: auto; line-height: var(--leading-relaxed); }
</style>
