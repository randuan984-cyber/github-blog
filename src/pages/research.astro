---
// research.astro — Research Log Page
// SPEC: SPEC-RESEARCH-001, TASK-009

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allResearch = await getCollection('research', ({ data }) => !data.draft);
const research = allResearch.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL;

const statusConfig: Record<string, { label: string; badge: string }> = {
  question:      { label: 'Open Question', badge: 'badge-planning' },
  exploring:     { label: 'Exploring',     badge: 'badge-learning' },
  experimenting: { label: 'Experimenting', badge: 'badge-in-progress' },
  concluded:     { label: 'Concluded',     badge: 'badge-completed' },
};

// Group by category
const byCategory = research.reduce<Record<string, typeof research>>((acc, entry) => {
  const cat = entry.data.category || 'General';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(entry);
  return acc;
}, {});

const categories = Object.keys(byCategory).sort();

const GITHUB_NEW_RESEARCH = 'https://github.com/randuan984-cyber/github-blog/new/main/src/content/research';
---

<BaseLayout
  title="Research"
  description="An open-ended research log — questions, literature notes, experiments, and reflections. No pre-defined direction."
>
  <div class="container page-container">
    <header class="page-header">
      <p class="section-label">Exploration</p>
      <h1 class="page-title">Research</h1>
      <p class="page-subtitle">
        An open-ended log of research questions, paper reading notes, experiments, and reflections.
        Research direction is not pre-defined — it emerges from real projects and curiosity.
      </p>
      <div class="header-actions">
        <a href={GITHUB_NEW_RESEARCH} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          记录新研究问题
        </a>
      </div>
    </header>

    <div class="research-note card" role="note">
      <p>
        <strong>Note on research:</strong> I have not yet committed to a specific research direction.
        This section will grow as I engage with real projects and encounter open questions that merit
        deeper investigation. Entries here represent genuine exploration, not pre-planned specialization.
      </p>
    </div>

    {categories.length > 0 ? (
      <div class="research-sections">
        {categories.map((category) => (
          <section class="research-category" aria-labelledby={`cat-${category}`}>
            <h2 class="category-heading" id={`cat-${category}`}>{category}</h2>

            <div class="research-list">
              {byCategory[category].map((entry) => {
                const sc = statusConfig[entry.data.status] || statusConfig['question'];
                return (
                  <div class="research-card card">
                    <div class="research-header">
                      <div class="research-meta">
                        <time datetime={entry.data.date.toISOString()} class="research-date">
                          {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(entry.data.date)}
                        </time>
                      </div>
                      <span class={`badge ${sc.badge}`}>{sc.label}</span>
                    </div>

                    <h3 class="research-title">{entry.data.title}</h3>

                    <div class="research-question">
                      <span class="question-label">Research Question</span>
                      <p class="question-text">{entry.data.question}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon" aria-hidden="true">🔭</div>
        <h2>Research Log is Empty</h2>
        <p>
          Research entries will appear here as I encounter questions worth investigating.
          I'll add entries honestly — only when I have genuine questions or observations, not hypothetical research.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-container { padding-block: var(--space-16); }
  .page-header { margin-bottom: var(--space-8); }
  .page-title { font-size: var(--text-4xl); font-weight: var(--font-bold); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-4); }
  .page-subtitle { font-size: var(--text-lg); color: var(--color-text-muted); line-height: var(--leading-relaxed); }
  .header-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-5); }

  .research-note {
    margin-bottom: var(--space-10);
    padding: var(--space-5) var(--space-6);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background-color: var(--color-accent-light);
    border-color: var(--color-accent-muted);
  }

  .research-note p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--leading-relaxed); margin: 0; }

  .research-sections { display: flex; flex-direction: column; gap: var(--space-12); }

  .category-heading {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .research-list { display: flex; flex-direction: column; gap: var(--space-4); }

  .research-card { padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }

  .research-header { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .research-meta { display: flex; align-items: center; gap: var(--space-3); }
  .research-date { font-size: var(--text-xs); color: var(--color-text-faint); font-family: 'JetBrains Mono', monospace; }

  .research-title { font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--color-text); }

  .research-question {
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .question-label { font-size: var(--text-xs); font-weight: var(--font-semibold); letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--color-text-faint); }
  .question-text { font-size: var(--text-sm); color: var(--color-text-muted); font-style: italic; line-height: var(--leading-relaxed); margin: 0; }

  .empty-state { text-align: center; padding: var(--space-20) var(--space-8); border: 1px dashed var(--color-border); border-radius: var(--radius-xl); background-color: var(--color-surface); }
  .empty-icon { font-size: 3rem; margin-bottom: var(--space-4); }
  .empty-state h2 { font-size: var(--text-2xl); margin-bottom: var(--space-4); }
  .empty-state p { color: var(--color-text-muted); max-width: 52ch; margin-inline: auto; line-height: var(--leading-relaxed); }
</style>
