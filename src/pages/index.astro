---
// index.astro — Home Page
// SPEC: SPEC-HOME-001, TASK-005
// Goal: HR/interviewer understands "who / what I learn / what I build" in 30 seconds

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch featured projects (max 3)
const allProjects = await getCollection('projects', ({ data }) => !data.draft && data.featured);
const featuredProjects = allProjects
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Fetch latest blog posts (max 3)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL;

// Status badge helper
const statusBadge: Record<string, { label: string; class: string }> = {
  planning:     { label: 'Planning',     class: 'badge-planning' },
  learning:     { label: 'Learning',     class: 'badge-learning' },
  'in-progress':{ label: 'In Progress',  class: 'badge-in-progress' },
  completed:    { label: 'Completed',    class: 'badge-completed' },
  archived:     { label: 'Archived',     class: 'badge-archived' },
};
---

<BaseLayout
  title="Ran | Engineering Portfolio"
  description="Personal Engineering & Learning Portfolio — documenting real projects, engineering problems, and the learning process in AI/ML and software engineering."
>
  <!-- ─── HERO ──────────────────────────────────────────────────────────── -->
  <section class="hero section" aria-labelledby="hero-heading">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-eyebrow section-label" aria-hidden="true">
          <span class="eyebrow-dot"></span>
          Available for opportunities
        </div>

        <h1 class="hero-title" id="hero-heading">
          Hi, I'm <span class="hero-name">Ran</span>.
        </h1>

        <p class="hero-domain">
          AI Engineering · Software Development · Research
        </p>

        <p class="hero-bio">
          I learn by building real projects, documenting engineering problems,
          and turning what I learn into practical knowledge.
          This portfolio grows with my actual experience — no fabricated metrics.
        </p>

        <div class="hero-cta" role="list">
          <a href={`${base}projects/`} class="btn btn-primary btn-lg" role="listitem">
            View Projects
          </a>
          <a href="https://github.com/randuan984-cyber" class="btn btn-outline btn-lg" target="_blank" rel="noopener noreferrer" role="listitem">
            GitHub
          </a>
          <a href={`${base}blog/`} class="btn btn-ghost btn-lg" role="listitem">
            Blog
          </a>
          <a href={`${base}resume/`} class="btn btn-ghost btn-lg" role="listitem">
            Resume
          </a>
        </div>
      </div>

      <!-- Hero visual / decoration — engineering terminal aesthetic -->
      <div class="hero-visual" aria-hidden="true">
        <div class="terminal-card">
          <div class="terminal-header">
            <span class="terminal-dot terminal-dot--red"></span>
            <span class="terminal-dot terminal-dot--yellow"></span>
            <span class="terminal-dot terminal-dot--green"></span>
            <span class="terminal-title">profile.yaml</span>
          </div>
          <div class="terminal-body">
            <pre class="terminal-code"><code><span class="t-key">name</span><span class="t-colon">:</span> <span class="t-string">Ran</span>
<span class="t-key">focus</span><span class="t-colon">:</span>
  - <span class="t-string">AI/ML Engineering</span>
  - <span class="t-string">Software Architecture</span>
  - <span class="t-string">Open Source Study</span>
<span class="t-key">learning</span><span class="t-colon">:</span> <span class="t-bool">true</span>
<span class="t-key">building</span><span class="t-colon">:</span> <span class="t-bool">true</span>
<span class="t-key">documenting</span><span class="t-colon">:</span> <span class="t-bool">true</span></code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CURRENT FOCUS ───────────────────────────────────────────────── -->
  <section class="focus-section section" aria-labelledby="focus-heading">
    <div class="container">
      <p class="section-label">
        <span class="status-dot status-dot--active" aria-hidden="true"></span>
        Currently
      </p>
      <h2 class="section-title" id="focus-heading">What I'm Working On</h2>
      <p class="section-subtitle">
        These are the areas I'm actively studying and building in right now.
      </p>

      <div class="focus-grid">
        <!-- Item 1 -->
        <div class="focus-card card">
          <div class="focus-card-header">
            <span class="badge badge-in-progress">Active</span>
          </div>
          <h3 class="focus-card-title">Exploring AI/ML Fundamentals</h3>
          <p class="focus-card-desc">
            Studying the foundations of machine learning and AI engineering through real open-source projects.
            Currently reading and experimenting with signal processing and deep learning basics.
          </p>
          <p class="focus-card-meta">Started: Aug 2026</p>
        </div>

        <!-- Item 2 -->
        <div class="focus-card card">
          <div class="focus-card-header">
            <span class="badge badge-in-progress">Active</span>
          </div>
          <h3 class="focus-card-title">Building in Public</h3>
          <p class="focus-card-desc">
            Learning to document engineering problems, solutions, and learning processes openly.
            This portfolio site is the first artifact of that practice.
          </p>
          <p class="focus-card-meta">Started: Aug 2026</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FEATURED PROJECTS ──────────────────────────────────────────── -->
  <section class="projects-section section" aria-labelledby="projects-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-label">Work</p>
          <h2 class="section-title" id="projects-heading">Featured Projects</h2>
          <p class="section-subtitle">
            Real projects with full context — what the problem was, how I approached it, and what I learned.
          </p>
        </div>
        <a href={`${base}projects/`} class="btn btn-outline">All Projects →</a>
      </div>

      {featuredProjects.length > 0 ? (
        <div class="projects-grid">
          {featuredProjects.map((project) => {
            const badge = statusBadge[project.data.status] || statusBadge['planning'];
            return (
              <a href={`${base}projects/${project.slug}/`} class="project-card card card-link">
                <div class="project-card-header">
                  <span class={`badge ${badge.class}`}>{badge.label}</span>
                  {project.data.source_type !== 'original' && (
                    <span class="badge badge-fork">Open Source Study</span>
                  )}
                </div>

                <h3 class="project-title">{project.data.title}</h3>
                <p class="project-desc">{project.data.description}</p>

                {project.data.tech_stack.length > 0 && (
                  <div class="project-stack">
                    {project.data.tech_stack.slice(0, 4).map((tech) => (
                      <span class="tag">{tech}</span>
                    ))}
                  </div>
                )}

                <div class="project-card-footer">
                  <span class="project-date">
                    {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(project.data.date)}
                  </span>
                  <span class="project-cta">View case study →</span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-state-icon" aria-hidden="true">🚧</div>
          <h3>Projects Coming Soon</h3>
          <p>
            I'm currently studying and building. Projects will appear here once they're documented.
            Check the <a href="https://github.com/randuan984-cyber">GitHub</a> for work in progress.
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- ─── LATEST FROM THE BLOG ──────────────────────────────────────── -->
  <section class="blog-section section" aria-labelledby="blog-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-label">Writing</p>
          <h2 class="section-title" id="blog-heading">Latest Notes & Posts</h2>
          <p class="section-subtitle">
            Engineering notes, learning reflections, and technical write-ups.
            I document failures and dead ends, not just polished results.
          </p>
        </div>
        <a href={`${base}blog/`} class="btn btn-outline">All Posts →</a>
      </div>

      {latestPosts.length > 0 ? (
        <div class="blog-list">
          {latestPosts.map((post) => (
            <a href={`${base}blog/${post.slug}/`} class="blog-item card card-link">
              <div class="blog-item-meta">
                <time datetime={post.data.date.toISOString()} class="blog-date">
                  {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(post.data.date)}
                </time>
                {post.data.categories.length > 0 && (
                  <span class="tag">{post.data.categories[0]}</span>
                )}
              </div>
              <h3 class="blog-title">{post.data.title}</h3>
              <p class="blog-excerpt">{post.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-state-icon" aria-hidden="true">✏️</div>
          <h3>Writing in Progress</h3>
          <p>
            I'm developing the habit of writing about engineering problems as I encounter them.
            First posts coming soon as I document my learning process.
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- ─── LEARNING PHILOSOPHY / GITHUB STRIP ──────────────────────── -->
  <section class="github-strip section" aria-labelledby="github-heading">
    <div class="container">
      <div class="github-strip-inner card">
        <div class="github-strip-content">
          <h2 class="github-strip-title" id="github-heading">
            Learning by building real things.
          </h2>
          <p class="github-strip-text">
            I study real open-source projects, fork them, experiment, break them,
            document what I learned, and move forward. Everything here is honest.
          </p>
          <div class="github-strip-links">
            <a href="https://github.com/randuan984-cyber" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              View GitHub →
            </a>
            <a href={`${base}journey/`} class="btn btn-ghost">
              See Learning Journey
            </a>
          </div>
        </div>
        <div class="github-strip-stat" aria-hidden="true">
          <div class="stat-item">
            <span class="stat-label">Status</span>
            <span class="stat-value">Actively Learning</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Approach</span>
            <span class="stat-value">Build → Document → Reflect</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Honesty</span>
            <span class="stat-value">No fake metrics</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ───────────────────────────────────────────────────────────── */
  .hero {
    padding-block: var(--space-24);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .hero-eyebrow {
    margin-bottom: var(--space-6);
  }

  .eyebrow-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background-color: var(--color-completed);
    border-radius: var(--radius-full);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  .hero-title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-5xl));
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .hero-name {
    color: var(--color-accent);
  }

  .hero-domain {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .hero-bio {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 50ch;
    margin-bottom: var(--space-8);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Terminal card visual */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .terminal-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 380px;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
  }

  .terminal-dot--red    { background-color: #ff5f57; }
  .terminal-dot--yellow { background-color: #febc2e; }
  .terminal-dot--green  { background-color: #28c840; }

  .terminal-title {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    margin-left: var(--space-2);
    font-family: 'JetBrains Mono', monospace;
  }

  .terminal-body {
    padding: var(--space-6);
  }

  .terminal-code {
    background: none !important;
    border: none !important;
    padding: 0 !important;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
  }

  .t-key    { color: var(--color-accent); }
  .t-colon  { color: var(--color-text-faint); }
  .t-string { color: var(--color-text); }
  .t-bool   { color: #f59e0b; }

  /* ─── Focus Section ─────────────────────────────────────────────────── */
  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
  }

  .status-dot--active {
    background-color: var(--color-completed);
    animation: pulse 2s infinite;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .focus-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .focus-card-header {
    display: flex;
    gap: var(--space-2);
  }

  .focus-card-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .focus-card-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .focus-card-meta {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    font-family: 'JetBrains Mono', monospace;
  }

  /* ─── Section Header (with right-aligned CTA) ──────────────────────── */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
    flex-wrap: wrap;
  }

  /* ─── Projects Grid ─────────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-5);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-card-header {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .badge-fork {
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-color: var(--color-accent-muted);
  }

  .project-title {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .project-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  .project-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .project-date {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    font-family: 'JetBrains Mono', monospace;
  }

  .project-cta {
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: var(--font-medium);
  }

  /* ─── Blog List ─────────────────────────────────────────────────────── */
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .blog-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
  }

  .blog-item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .blog-date {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    font-family: 'JetBrains Mono', monospace;
  }

  .blog-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .blog-excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ─── GitHub Strip ──────────────────────────────────────────────────── */
  .github-strip-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    align-items: center;
    padding: var(--space-10);
  }

  .github-strip-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
  }

  .github-strip-text {
    color: var(--color-text-muted);
    max-width: 52ch;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .github-strip-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .github-strip-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    flex-shrink: 0;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-label {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .stat-value {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-accent);
    font-family: 'JetBrains Mono', monospace;
  }

  /* ─── Empty State ───────────────────────────────────────────────────── */
  .empty-state {
    text-align: center;
    padding: var(--space-16) var(--space-8);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
  }

  .empty-state-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-4);
  }

  .empty-state h3 {
    font-size: var(--text-xl);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .empty-state p {
    color: var(--color-text-muted);
    max-width: 48ch;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
  }

  /* ─── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .hero-visual {
      order: -1;
    }

    .github-strip-inner {
      grid-template-columns: 1fr;
    }

    .github-strip-stat {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-16);
    }

    .hero-cta {
      flex-direction: column;
    }

    .hero-cta .btn {
      width: 100%;
      justify-content: center;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
