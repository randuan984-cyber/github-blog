---
// journey.astro — Learning Timeline Page
// SPEC: SPEC-JOURNEY-001, TASK-007

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('journey');
const entries = allEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL;

// Group by year
const byYear = entries.reduce<Record<string, typeof entries>>((acc, entry) => {
  const year = entry.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(entry);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

const statusColors: Record<string, string> = {
  exploring:  'badge-planning',
  learning:   'badge-learning',
  practicing: 'badge-in-progress',
  completed:  'badge-completed',
};
---

<BaseLayout
  title="Learning Journey"
  description="A chronological record of my real learning journey — what I studied, practiced, and took away. Honest timeline of growth."
>
  <div class="container page-container">
    <header class="page-header">
      <p class="section-label">Timeline</p>
      <h1 class="page-title">Learning Journey</h1>
      <p class="page-subtitle">
        This is not a skills list. It's a chronological record of what I've actually studied,
        practiced, and learned — including what was difficult and what I'm still working on.
      </p>
    </header>

    {years.length > 0 ? (
      <div class="timeline">
        {years.map((year) => (
          <div class="timeline-year">
            <div class="year-marker" aria-label={`Year ${year}`}>
              <span class="year-label">{year}</span>
              <div class="year-line" aria-hidden="true"></div>
            </div>

            <div class="timeline-entries">
              {byYear[year].map((entry) => (
                <div class="timeline-entry card">
                  <div class="entry-connector" aria-hidden="true">
                    <div class="connector-dot"></div>
                  </div>

                  <div class="entry-content">
                    <div class="entry-header">
                      <div class="entry-meta">
                        <time datetime={entry.data.date.toISOString()} class="entry-date">
                          {new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(entry.data.date)}
                        </time>
                        <span class="entry-category">{entry.data.category}</span>
                      </div>
                      <span class={`badge ${statusColors[entry.data.status] || 'badge-planning'}`}>
                        {entry.data.status}
                      </span>
                    </div>

                    <h2 class="entry-title">{entry.data.title}</h2>
                    <p class="entry-summary">{entry.data.summary}</p>

                    {entry.data.what_i_learned && (
                      <div class="entry-learned">
                        <span class="learned-label">Key takeaway:</span>
                        <span class="learned-text">{entry.data.what_i_learned}</span>
                      </div>
                    )}

                    {(entry.data.related_projects.length > 0 || entry.data.related_posts.length > 0) && (
                      <div class="entry-links">
                        {entry.data.related_projects.map((slug) => (
                          <a href={`${base}projects/${slug}/`} class="entry-link">→ Project: {slug}</a>
                        ))}
                        {entry.data.related_posts.map((slug) => (
                          <a href={`${base}blog/${slug}/`} class="entry-link">→ Post: {slug}</a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon" aria-hidden="true">📅</div>
        <h2>Timeline Starting</h2>
        <p>
          Learning journey entries will appear here as I document what I'm studying and practicing.
          This is where the honest record of growth lives.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-container { padding-block: var(--space-16); }
  .page-header { max-width: 56ch; margin-bottom: var(--space-12); }
  .page-title { font-size: var(--text-4xl); font-weight: var(--font-bold); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-4); }
  .page-subtitle { font-size: var(--text-lg); color: var(--color-text-muted); line-height: var(--leading-relaxed); }

  .timeline { display: flex; flex-direction: column; gap: var(--space-10); }

  .timeline-year { }

  .year-marker {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .year-label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    font-family: 'JetBrains Mono', monospace;
    color: var(--color-accent);
    letter-spacing: var(--tracking-wide);
    flex-shrink: 0;
  }

  .year-line {
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .timeline-entries {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-left: var(--space-6);
    border-left: 2px solid var(--color-border);
  }

  .timeline-entry {
    position: relative;
    padding: var(--space-5) var(--space-6);
  }

  .entry-connector {
    position: absolute;
    left: calc(-1 * var(--space-6) - 5px);
    top: var(--space-6);
  }

  .connector-dot {
    width: 10px;
    height: 10px;
    background-color: var(--color-accent);
    border-radius: var(--radius-full);
    border: 2px solid var(--color-bg);
  }

  .entry-content { display: flex; flex-direction: column; gap: var(--space-3); }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .entry-meta { display: flex; align-items: center; gap: var(--space-3); }
  .entry-date { font-size: var(--text-xs); color: var(--color-text-faint); font-family: 'JetBrains Mono', monospace; }
  .entry-category { font-size: var(--text-xs); color: var(--color-text-muted); background-color: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 0.15em 0.5em; }

  .entry-title { font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--color-text); }
  .entry-summary { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--leading-relaxed); }

  .entry-learned {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    background-color: var(--color-accent-light);
    border-left: 3px solid var(--color-accent);
    padding: var(--space-3) var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .learned-label { font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--color-accent); white-space: nowrap; }
  .learned-text { font-size: var(--text-sm); color: var(--color-text-muted); font-style: italic; }

  .entry-links { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .entry-link { font-size: var(--text-xs); color: var(--color-accent); text-decoration: none; }
  .entry-link:hover { text-decoration: underline; }

  .empty-state { text-align: center; padding: var(--space-20) var(--space-8); border: 1px dashed var(--color-border); border-radius: var(--radius-xl); background-color: var(--color-surface); }
  .empty-icon { font-size: 3rem; margin-bottom: var(--space-4); }
  .empty-state h2 { font-size: var(--text-2xl); margin-bottom: var(--space-4); }
  .empty-state p { color: var(--color-text-muted); max-width: 52ch; margin-inline: auto; line-height: var(--leading-relaxed); }

  @media (max-width: 640px) {
    .timeline-entries { padding-left: var(--space-4); }
    .entry-connector { left: calc(-1 * var(--space-4) - 5px); }
  }
</style>
