---
// blog/index.astro — Blog List Page
// SPEC: SPEC-BLOG-001, TASK-010

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL;

// Collect all categories
const allCategories = [...new Set(posts.flatMap((p) => p.data.categories))].sort();

// Estimate reading time (rough: 200 words/min)
function readingTime(post: any) {
  // words count approximation — we don't have body here, so show nothing
  return null;
}
---

<BaseLayout
  title="Blog"
  description="Engineering notes, learning reflections, and technical write-ups. I document failures and dead ends, not just polished results."
>
  <div class="container page-container">
    <header class="page-header">
      <p class="section-label">Writing</p>
      <h1 class="page-title">Blog</h1>
      <p class="page-subtitle">
        Engineering notes, learning reflections, and technical write-ups.
        I write about <em>why</em> things failed, not just what worked.
      </p>
    </header>

    {allCategories.length > 0 && (
      <div class="category-filter" role="navigation" aria-label="Filter by category">
        <span class="filter-label">Filter:</span>
        <div class="filter-pills">
          <a href={`${base}blog/`} class="filter-pill filter-pill--active">All</a>
          {allCategories.map((cat) => (
            <a href={`${base}blog/?category=${encodeURIComponent(cat)}`} class="filter-pill">{cat}</a>
          ))}
        </div>
      </div>
    )}

    {posts.length > 0 ? (
      <div class="posts-list">
        {posts.map((post) => (
          <a href={`${base}blog/${post.slug}/`} class="post-item card card-link">
            <div class="post-meta">
              <time datetime={post.data.date.toISOString()} class="post-date">
                {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(post.data.date)}
              </time>
              {post.data.categories.map((cat) => (
                <span class="tag">{cat}</span>
              ))}
            </div>

            <h2 class="post-title">{post.data.title}</h2>
            <p class="post-excerpt">{post.data.description}</p>

            {post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.slice(0, 4).map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon" aria-hidden="true">✏️</div>
        <h2>Writing in Progress</h2>
        <p>
          I'm developing the habit of documenting engineering problems as I encounter them.
          First posts are coming as I work through real projects and encounter real issues.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-container { padding-block: var(--space-16); }

  .page-header {
    max-width: 56ch;
    margin-bottom: var(--space-10);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .category-filter {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .filter-pills {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .filter-pill {
    padding: var(--space-1-5) var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover,
  .filter-pill--active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .post-date {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    font-family: 'JetBrains Mono', monospace;
  }

  .post-title {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .post-excerpt {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-20) var(--space-8);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
  }

  .empty-icon { font-size: 3rem; margin-bottom: var(--space-4); }

  .empty-state h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .empty-state p {
    color: var(--color-text-muted);
    max-width: 52ch;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
  }
</style>
